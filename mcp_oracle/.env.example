# Oracle DBA Agent - Configuración de Variables de Entorno
# Copiar este archivo como .env y completar los valores

# Usuario de Oracle
ORACLE_USER=tu_usuario

# Contraseña de Oracle
ORACLE_PASSWORD=tu_password

# DSN (Data Source Name) de Oracle
# Formato: host:port/service_name
# Ejemplo: localhost:1521/xe
ORACLE_DSN=localhost:1521/xe

# Alternativa: TNS Entry
# ORACLE_DSN=mi_tns_entry
